# ── DSH（本机 Web GUI 的 /api，loopback）────────────────────────────
DSH_URL=http://127.0.0.1:3080
# 新建会话的工作目录（留空 = 桥接进程启动目录）
DSH_CWD=
# 新建会话使用的 agent preset（留空 = 用 DSH 默认）
DSH_AGENT_PRESET=

# ── 企业微信自建应用 ────────────────────────────────────────────────
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
# 回调消息加解密（与「接收消息」配置页里填的一致）
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
# 置 1 = dry-run：sendText/sendMarkdown 只打印、不调企业微信 API（接真实账号前自测用）
WECOM_DRY_RUN=0

# ── 桥接自身 ────────────────────────────────────────────────────────
# 桥接 HTTP 服务监听端口（企业微信回调 / Cloudflare Tunnel 指向这里）
BRIDGE_PORT=8787
# 会话映射持久化文件
BRIDGE_STORE=./data/mappings.json
