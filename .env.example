# ── DSH（本机 Web GUI 的 /api，loopback）────
DSH_URL=http://127.0.0.1:3080
# 新建会话的工作目录（按需改）
DSH_CWD=你的工作目录
# 新建会话使用的 agent preset
DSH_AGENT_PRESET=cordis

# ── 桥接自身 ──
BRIDGE_PORT=8787
BRIDGE_STORE=./data/mappings.json

# ── 手机网页访问密码（Tailscale 版：经 https://<机器名>.<tailnet>.ts.net/ 访问）──
WEB_PASSWORD=改成你的密码